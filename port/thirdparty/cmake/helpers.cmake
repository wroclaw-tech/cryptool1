include_guard(GLOBAL)

set(CT_THIRDPARTY_ALIAS_ROOT "${CMAKE_CURRENT_BINARY_DIR}/case_aliases")

# Silences warnings and relaxes aliasing for legacy third-party code.
function(ct_thirdparty_target target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /w)
  else()
    target_compile_options(${target} PRIVATE -w -fno-strict-aliasing)
  endif()
  set_target_properties(${target} PROPERTIES
    POSITION_INDEPENDENT_CODE ${CRYPTOOL_THIRDPARTY_PIC}
    FOLDER "thirdparty")
endfunction()

# Creates a directory of forwarding headers so that #include spellings that
# only differ in case from the files on disk resolve on case-sensitive file
# systems. Every header gets an all-lowercase alias (unless SCANNED_ONLY); in
# addition every spelling found in the #include directives of SCAN_FILES that
# case-insensitively matches a header in HEADER_DIRS gets its own alias.
# INCLUDE_EXACT also forwards the exact on-disk names (for prefix directories).
#   ct_case_aliases(OUT_DIR <dir> HEADER_DIRS <dir>... [SCAN_FILES <file>...]
#                   [EXCLUDE <lowercase-name>...] [SCANNED_ONLY] [INCLUDE_EXACT])
function(ct_case_aliases)
  cmake_parse_arguments(A "SCANNED_ONLY;INCLUDE_EXACT" "OUT_DIR" "HEADER_DIRS;SCAN_FILES;EXCLUDE" ${ARGN})
  file(MAKE_DIRECTORY "${A_OUT_DIR}")
  set(_lower_names "")
  foreach(_dir IN LISTS A_HEADER_DIRS)
    file(GLOB _headers RELATIVE "${_dir}" "${_dir}/*")
    foreach(_h IN LISTS _headers)
      if(IS_DIRECTORY "${_dir}/${_h}" OR NOT _h MATCHES "\\.([hH]|[hH][pP][pP]|[hH][hH]|[iI][nN][lL])$")
        continue()
      endif()
      string(TOLOWER "${_h}" _lh)
      if(_lh IN_LIST A_EXCLUDE)
        continue()
      endif()
      if(NOT DEFINED "_map_${_lh}")
        set("_map_${_lh}" "${_dir}/${_h}")
        list(APPEND _lower_names "${_lh}")
      endif()
    endforeach()
  endforeach()

  set(_spellings "")
  if(NOT A_SCANNED_ONLY)
    list(APPEND _spellings ${_lower_names})
  endif()
  if(A_INCLUDE_EXACT)
    foreach(_ln IN LISTS _lower_names)
      get_filename_component(_exact "${_map_${_ln}}" NAME)
      list(APPEND _spellings "${_exact}")
    endforeach()
  endif()
  foreach(_f IN LISTS A_SCAN_FILES)
    file(STRINGS "${_f}" _lines REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
    foreach(_l IN LISTS _lines)
      if(_l MATCHES "^[ \t]*#[ \t]*include[ \t]*[<\"]([^>\"/\\\\]+)[>\"]")
        list(APPEND _spellings "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES _spellings)

  foreach(_n IN LISTS _spellings)
    string(TOLOWER "${_n}" _ln)
    if(NOT DEFINED "_map_${_ln}")
      continue()
    endif()
    set(_target "${_map_${_ln}}")
    get_filename_component(_actual "${_target}" NAME)
    if(_actual STREQUAL _n AND NOT A_INCLUDE_EXACT)
      continue()
    endif()
    _ct_write_if_different("${A_OUT_DIR}/${_n}"
      "/* generated case alias */\n#include \"${_target}\"\n")
  endforeach()
endfunction()

function(_ct_write_if_different path content)
  if(EXISTS "${path}")
    file(READ "${path}" _old)
    if(_old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()

# Registers a smoke test executable with CTest.
#   ct_add_smoke_test(<name> SOURCES <src>... LIBS <lib>... [DEFINES <def>...] [ARGS <arg>...])
function(ct_add_smoke_test name)
  if(NOT CRYPTOOL_THIRDPARTY_TESTS)
    return()
  endif()
  cmake_parse_arguments(A "" "" "SOURCES;LIBS;DEFINES;ARGS" ${ARGN})
  add_executable(${name} ${A_SOURCES})
  target_link_libraries(${name} PRIVATE ${A_LIBS})
  if(A_DEFINES)
    target_compile_definitions(${name} PRIVATE ${A_DEFINES})
  endif()
  set_target_properties(${name} PROPERTIES FOLDER "thirdparty/tests")
  add_test(NAME ${name} COMMAND ${name} ${A_ARGS})
endfunction()
